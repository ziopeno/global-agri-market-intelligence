generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReportType {
  daily
  weekly
  monthly
  quarterly
  half_year
  annual
}

enum ReviewStatus {
  ai_generated
  human_reviewed
  locked
}

enum FetchStatus {
  pending
  fetched
  duplicate
  failed
  manual
}

enum AnalysisStatus {
  pending
  analyzing
  completed
  failed
  skipped
}

model NewsSource {
  id            String         @id @default(cuid())
  name          String
  url           String         @unique
  category      String?
  country       String?
  isActive      Boolean        @default(true) @map("is_active")
  lastFetchedAt DateTime?      @map("last_fetched_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  articles      Article[]
  fetchLogs     NewsFetchLog[]

  @@index([isActive])
  @@map("news_sources")
}

model Article {
  id                  String           @id @default(cuid())
  title               String
  source              String
  url                 String           @unique
  sourceId            String?          @map("source_id")
  newsSource          NewsSource?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  publishedAt         DateTime         @map("published_at")
  country             String?
  crop                String?
  category            String?
  originalText        String           @map("original_text") @db.Text
  rawContent          String?          @map("raw_content") @db.Text
  summary             String?          @db.Text
  marketImpactScore   Float            @default(0) @map("market_impact_score")
  adjustedMarketScore Float            @default(0) @map("adjusted_market_score")
  fetchStatus         FetchStatus      @default(pending) @map("fetch_status")
  analysisStatus      AnalysisStatus   @default(pending) @map("analysis_status")
  duplicateKey        String           @unique @default(cuid()) @map("duplicate_key")
  fetchedAt           DateTime?        @map("fetched_at")
  reviewStatus        ReviewStatus     @default(ai_generated) @map("review_status")
  createdAt           DateTime         @default(now()) @map("created_at")
  factors             ArticleFactor[]
  factorEvidence      FactorEvidence[]
  productImpacts      ProductImpact[]
  analysis            ArticleAnalysis?

  @@index([publishedAt])
  @@index([sourceId])
  @@index([country])
  @@index([crop])
  @@index([category])
  @@index([fetchStatus])
  @@index([analysisStatus])
  @@map("articles")
}

model ArticleAnalysis {
  id                  String   @id @default(cuid())
  articleId           String   @unique @map("article_id")
  article             Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  summary             String   @db.Text
  country             String?
  crop                String?
  category            String?
  marketImpactScore   Float    @map("market_impact_score")
  adjustedMarketScore Float    @default(0) @map("adjusted_market_score")
  rawResponse         Json?    @map("raw_response")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([country])
  @@index([crop])
  @@index([category])
  @@map("article_analyses")
}

model ArticleFactor {
  id                     String                @id @default(cuid())
  articleId              String                @map("article_id")
  article                Article               @relation(fields: [articleId], references: [id], onDelete: Cascade)
  factorName             String                @map("factor_name")
  direction              Int
  impact                 Int
  likelihood             Int
  duration               Float
  reliability            Float
  factorScore            Float                 @map("factor_score")
  marketSizeWeight       Float                 @default(1) @map("market_size_weight")
  productRelevanceWeight Float                 @default(1) @map("product_relevance_weight")
  recencyWeight          Float                 @default(1) @map("recency_weight")
  evidenceStrength       Float                 @default(1) @map("evidence_strength")
  adjustedFactorScore    Float                 @default(0) @map("adjusted_factor_score")
  evidence               String?               @db.Text
  manualFactorScore      Float?                @map("manual_factor_score")
  createdAt              DateTime              @default(now()) @map("created_at")
  factorEvidence         FactorEvidence[]
  revisions              FactorScoreRevision[]

  @@index([articleId])
  @@index([factorName])
  @@map("article_factors")
}

model FactorEvidence {
  id               String         @id @default(cuid())
  articleId        String         @map("article_id")
  article          Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  factorId         String?        @map("factor_id")
  factor           ArticleFactor? @relation(fields: [factorId], references: [id], onDelete: SetNull)
  factorName       String         @map("factor_name")
  evidenceSentence String         @map("evidence_sentence") @db.Text
  extractedByAi    Boolean        @default(true) @map("extracted_by_ai")
  confidence       Float          @default(0.7)
  reviewerComment  String?        @map("reviewer_comment") @db.Text
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([articleId])
  @@index([factorId])
  @@index([factorName])
  @@map("factor_evidence")
}

model FactorScoreRevision {
  id              String        @id @default(cuid())
  articleId       String        @map("article_id")
  factorId        String        @map("factor_id")
  factor          ArticleFactor @relation(fields: [factorId], references: [id], onDelete: Cascade)
  factorName      String        @map("factor_name")
  previousValues  Json          @map("previous_values")
  newValues       Json          @map("new_values")
  reviewerComment String?       @map("reviewer_comment") @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([articleId])
  @@index([factorId])
  @@map("factor_score_revisions")
}

model CountryBusinessWeight {
  id                       String   @id @default(cuid())
  country                  String   @unique
  marketSizeWeight         Float    @default(1) @map("market_size_weight")
  businessImportanceWeight Float    @default(1) @map("business_importance_weight")
  notes                    String?  @db.Text
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@index([country])
  @@map("country_business_weights")
}

model MarketSignal {
  id                String   @id @default(cuid())
  country           String?
  crop              String?
  category          String
  signalName        String   @map("signal_name")
  marketImpactScore Float    @map("market_impact_score")
  period            String
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([period])
  @@index([country])
  @@index([crop])
  @@map("market_signals")
}

model Product {
  id             String               @id @default(cuid())
  name           String               @unique
  category       String
  targetCrop     String?              @map("target_crop")
  targetCountry  String?              @map("target_country")
  description    String?              @db.Text
  sensitivities  ProductSensitivity[]
  productImpacts ProductImpact[]

  @@map("products")
}

model ProductSensitivity {
  id               String  @id @default(cuid())
  productId        String  @map("product_id")
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  factorName       String  @map("factor_name")
  sensitivityScore Float   @map("sensitivity_score")

  @@unique([productId, factorName])
  @@index([factorName])
  @@map("product_sensitivity")
}

model ProductImpact {
  id                 String   @id @default(cuid())
  productId          String   @map("product_id")
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  articleId          String   @map("article_id")
  article            Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  marketImpactScore  Float    @map("market_impact_score")
  sensitivityScore   Float    @map("sensitivity_score")
  productImpactScore Float    @map("product_impact_score")
  rationale          String?  @db.Text
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([productId, articleId])
  @@index([productId])
  @@index([articleId])
  @@map("product_impact")
}

model NewsFetchLog {
  id             String      @id @default(cuid())
  sourceId       String?     @map("source_id")
  source         NewsSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceName     String?     @map("source_name")
  status         String
  message        String?     @db.Text
  fetchedCount   Int         @default(0) @map("fetched_count")
  newCount       Int         @default(0) @map("new_count")
  duplicateCount Int         @default(0) @map("duplicate_count")
  analyzedCount  Int         @default(0) @map("analyzed_count")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([sourceId])
  @@index([createdAt])
  @@map("news_fetch_logs")
}

model Report {
  id                      String     @id @default(cuid())
  reportType              ReportType @map("report_type")
  title                   String
  periodStart             DateTime   @map("period_start")
  periodEnd               DateTime   @map("period_end")
  content                 Json
  keyInsights             Json       @map("key_insights")
  strategyRecommendations Json       @map("strategy_recommendations")
  sourceArticleIds        String[]   @map("source_article_ids")
  createdAt               DateTime   @default(now()) @map("created_at")

  @@index([reportType])
  @@index([periodStart, periodEnd])
  @@map("reports")
}
